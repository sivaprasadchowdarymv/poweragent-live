# Copy this file to .env and fill in the keys. Everything below is FREE with the default profile.

# --- AI providers (same as RAG∞ Ultimate) ---------------------------------------------
GROQ_API_KEY=            # text answers - free key: https://console.groq.com/keys
OPENROUTER_API_KEY=      # screen/chart images (Gemma 4 :free) - free key: https://openrouter.ai/settings/keys

# free    = Groq for text + Gemma 4 free for images ($0)         <- default
# quality = Groq for text + Qwen 3.8 for images (a few cents)
# local   = Ollama on this PC for everything ($0, nothing leaves the PC)
MODEL_PROFILE=free
IMAGE_ANSWERS=true       # screen questions: send chart crops of the latest capture to the vision model
LOCAL_ONLY=false         # true = never call Groq/OpenRouter (use with MODEL_PROFILE=local)
OLLAMA_ENABLED=false     # true = add local Ollama as last fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
VERIFY_WITH_LLM=false    # extra fact-check by Llama 3.3 70B (more tokens)
DAILY_BUDGET_USD=0       # >0 stops AI answers after this spend (paid models only)
# MASTER_MODELS=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile
# VISION_MODELS=openrouter:google/gemma-4-31b-it:free,openrouter:qwen/qwen2.5-vl-72b-instruct:free,openrouter:google/gemma-4-26b-a4b-it:free

# --- Capture & OCR -------------------------------------------------------------------
CAPTURE_INTERVAL=2
EXTRACTION_INTERVAL=2
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
VISION_NOTES=true        # vision-first: the vision model reads changed frames in the background
VISION_NOTES_INTERVAL=60 # seconds between background readings (free models: keep >= 60)
STORE_SCREENSHOTS=false  # opt-in replay frames

# --- Optional local chart model (chart_model_server/README.md) -------------------------
CHART_MODEL_ENABLED=false
CHART_MODEL_URL=http://127.0.0.1:8600

# --- Storage & guards ---------------------------------------------------------------------
DATA_DIR=data
RETENTION_DAYS=30
APP_PASSWORD=
RATE_LIMIT_PER_MIN=8
